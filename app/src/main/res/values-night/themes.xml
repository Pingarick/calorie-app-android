<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Тёмная тема: те же роли, но статус-бар уходит в фон, а не в зелёный. -->
    <style name="Theme.Calorie" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/calorie_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/calorie_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/calorie_accent</item>

        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Calorie.Dialog</item>
    </style>

</resources>
