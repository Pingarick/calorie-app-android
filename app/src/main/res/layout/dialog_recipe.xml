<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_5"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_5"
        android:paddingBottom="@dimen/space_2">

        <TextView
            android:id="@+id/tvRecipeTitle"
            style="@style/TextAppearance.Calorie.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Курица с гречкой и овощами" />

        <TextView
            android:id="@+id/tvRecipePortion"
            style="@style/TextAppearance.Calorie.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            tools:text="1.3 порц. · 520 г" />

        <TextView
            style="@style/TextAppearance.Calorie.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/recipe_ingredients" />

        <TextView
            android:id="@+id/tvRecipeIngredients"
            style="@style/TextAppearance.Calorie.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            tools:text="• Куриная грудка — 195 г\n• Гречка — 260 г" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_4"
            android:background="@color/outline" />

        <TextView
            style="@style/TextAppearance.Calorie.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/recipe_steps" />

        <TextView
            android:id="@+id/tvRecipeSteps"
            style="@style/TextAppearance.Calorie.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            tools:text="1. Промыть гречку и залить водой.\n2. Варить 15 минут." />

        <TextView
            android:id="@+id/tvRecipeError"
            style="@style/TextAppearance.Calorie.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textColor="@color/danger"
            android:visibility="gone"
            tools:text="HTTP 401: invalid key" />

        <ProgressBar
            android:id="@+id/progressRecipe"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_3"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecipeGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/recipe_generate"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
