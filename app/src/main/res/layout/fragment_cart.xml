<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <TextView
        style="@style/TextAppearance.Calorie.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/screen_padding"
        android:text="@string/cart_title" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Calorie.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/txtTotal"
                style="@style/TextAppearance.Calorie.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Корзина: 2 480 ₽" />

            <TextView
                android:id="@+id/txtBudget"
                style="@style/TextAppearance.Calorie.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                tools:text="Бюджет 3 000 ₽ · остаток 520 ₽" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBudget"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="@string/cart_budget_button"
                android:textColor="@color/calorie_primary"
                app:strokeColor="@color/calorie_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txtEmpty"
        style="@style/TextAppearance.Calorie.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_6"
        android:paddingEnd="@dimen/screen_padding"
        android:text="@string/cart_empty"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/diary_list_bottom_inset"
        tools:listitem="@layout/item_cart_line" />

</LinearLayout>
