<?xml version="1.0" encoding="utf-8"?>
<!-- Повторяющиеся оформления: текстовые роли, карточки, чипы. -->
<resources>

    <!-- ===== Текстовые роли ===== -->

    <style name="TextAppearance.Calorie.ScreenTitle" parent="">
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="TextAppearance.Calorie.Section" parent="">
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Calorie.CardTitle" parent="">
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Calorie.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Calorie.BodyStrong" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Calorie.Caption" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Calorie.Micro" parent="">
        <item name="android:textSize">@dimen/text_micro</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Calorie.Hero" parent="">
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="TextAppearance.Calorie.HeroBig" parent="">
        <item name="android:textSize">@dimen/text_hero_big</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <!-- Подпись к контролу в диалогах/онбординге (было WelcomeLabel) -->
    <style name="TextAppearance.Calorie.FieldLabel" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="WelcomeLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_6</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- ===== Компоненты ===== -->

    <style name="Widget.Calorie.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Карточка внутри карточки/списка: без обводки, чуть меньше радиус. -->
    <style name="Widget.Calorie.CardFlat" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">@dimen/radius_inner</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Calorie.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">38dp</item>
    </style>

    <style name="Widget.Calorie.MacroBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:layout_height">@dimen/macro_bar_height</item>
        <item name="android:max">100</item>
        <item name="android:progressBackgroundTint">@color/surface_variant</item>
    </style>

</resources>
